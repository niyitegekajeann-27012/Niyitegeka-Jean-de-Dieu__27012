  "item": [
    {
      "name": "Q1 - Library API",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/books"
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/books/1"
          }
        },
        {
          "name": "Search Books by Title",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/books/search?title=ubuntu"
          }
        },
        {
          "name": "Add New Book",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kinyarwanda Grammar\",\n  \"author\": \"Mugabo Eric\",\n  \"isbn\": \"978-0201633610\",\n  \"publicationYear\": 2022\n}"
            },
            "url": "http://localhost:8080/api/books"
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:8080/api/books/1"
          }
        }
      ]
    },
